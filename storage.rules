rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user's email is verified
    function isEmailVerified() {
      return isAuthenticated() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'google.com'
      );
    }

    // Helper function to check document ownership
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if user is an admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (isEmailVerified() && request.auth.token.email.lower() == 'ekpeprinceesor@gmail.com')
      );
    }

    // Helper function for valid image upload criteria
    function isValidImage(maxSize) {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
          && request.resource.size <= maxSize;
    }

    // Profiles & Avatars: Publicly readable, writeable only if file name starts with user's UID and is a valid image <= 5MB
    match /profiles/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() 
                  && fileName.matches(request.auth.uid + '_.*')
                  && isValidImage(5 * 1024 * 1024);
    }

    match /avatars/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() 
                  && fileName.matches(request.auth.uid + '_.*')
                  && isValidImage(5 * 1024 * 1024);
    }

    // Community post media: Valid images only <= 5MB
    match /community/{fileName} {
      allow read: if true;
      allow create, update: if isAuthenticated() 
                    && isValidImage(5 * 1024 * 1024);
      allow delete: if isAuthenticated();
    }

    // Story images: Publicly readable, valid images <= 5MB
    match /stories/{fileName} {
      allow read: if true;
      allow create, update: if isAuthenticated()
                    && isValidImage(5 * 1024 * 1024);
      allow delete: if isAuthenticated() || isAdmin();
    }

    // Housing Images: Publicly readable, uploadable only by verified users for their own housing posts, <= 5MB
    match /housing_images/{fileName} {
      allow read: if true;
      allow create, update: if isEmailVerified()
                    && fileName.matches('housing_' + request.auth.uid + '_.*')
                    && isValidImage(5 * 1024 * 1024);
      allow delete: if isAuthenticated() 
                    && (fileName.matches('housing_' + request.auth.uid + '_.*') || isAdmin());
    }

    // Chats: Only accessible by authenticated participants of the conversation or admin
    match /chats/{conversationId}/{allPaths=**} {
      allow read, write: if isAuthenticated() 
                    && ((request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participants) || isAdmin())
                    && (request.method == 'get' || isValidImage(5 * 1024 * 1024));
    }

    // Voice Notes: Max 10MB audio
    match /chat_audio/{conversationId}/{allPaths=**} {
      allow read, write: if isAuthenticated() 
                    && ((request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participants) || isAdmin())
                    && (request.method == 'get' || (request.resource.contentType.matches('audio/.*') && request.resource.size <= 10 * 1024 * 1024));
    }

    // Enrollments documents: writeable/readable by owner only. Max 10MB PDF or image.
    match /enrollments/{fileName} {
      allow read: if isAuthenticated() && (fileName.matches(request.auth.uid + '_.*') || isAdmin());
      allow create, update: if isAuthenticated() 
                    && fileName.matches(request.auth.uid + '_.*')
                    && request.resource.contentType.matches('(application/pdf|image/(jpeg|png|webp))')
                    && request.resource.size <= 10 * 1024 * 1024;
      allow delete: if isAuthenticated() && (fileName.matches(request.auth.uid + '_.*') || isAdmin());
    }

    // Secure default catch-all rule: Deny all by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
