# AfroEduGo Environment Configuration Template
# Copy this file to .env.local for local development.
# NEVER commit .env, .env.local, or actual production credentials to GitHub!

# -------------------------------------------------------------
# Public Client Variables (Exposed to the browser via Next.js)
# -------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_fcm_vapid_key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# -------------------------------------------------------------
# Private Server-Only Secrets (NEVER prefix with NEXT_PUBLIC_)
# -------------------------------------------------------------
# Firebase Admin SDK Credentials
FIREBASE_ADMIN_PROJECT_ID=your_firebase_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxx@your_project_id.iam.gserviceaccount.com
# Paste the full private key including -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY-----
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Cron & Background Jobs Authorization Secret
CRON_SECRET=your_secure_random_cron_secret_min_32_chars

# Resend API Key for Transactional & Marketing Emails
RESEND_API_KEY=re_your_resend_api_key

# Admin SMTP / Email Notification Credentials
ADMIN_EMAIL=support@afroedugo.com
ADMIN_EMAIL_PASSWORD=your_secure_app_password

# Webhook Signing Secret (Resend / Stripe / Custom)
WEBHOOK_SECRET=whsec_your_webhook_signing_secret
