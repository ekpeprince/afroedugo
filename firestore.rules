rules_version = '2';
 
service cloud.firestore {
  match /databases/{database}/documents {
     
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user's email is verified (or signed in via Google OAuth)
    function isEmailVerified() {
      return isAuthenticated() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'google.com'
      );
    }
 
    // Helper function to check document ownership
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to verify admin privileges (strict email + verified email or custom claim)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (isEmailVerified() && (
          request.auth.token.email.lower() == 'ekpeprinceesor@gmail.com'
        ))
      );
    }
 
    // --- Users Collection (Row-Level Security & Privilege Escalation Prevention) ---
    match /users/{userId} {
      // Public profile data is readable by authenticated users
      allow read: if isAuthenticated();
      
      // User can create their own doc, but CANNOT self-assign 'admin' role
      allow create: if isOwner(userId) && (
        !request.resource.data.keys().hasAny(['role', 'isVerified']) ||
        request.resource.data.role != 'admin' ||
        isAdmin()
      );
      
      // User can update their own doc, but CANNOT escalate privileges (role or isVerified)
      allow update: if (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isVerified', 'joinedAt'])
      ) || isAdmin();
      
      // Only admin can delete user profiles
      allow delete: if isAdmin();
    }
 
    // --- Schools Collection ---
    match /schools/{schoolId} {
      allow read: if true; // Publicly readable
      allow write: if isAdmin(); // Only verified admins can modify
    }
 
    // --- Housing Collection ---
    match /housing/{housingId} {
      allow read: if true; // Publicly readable
      
      // Creating requires verified email to mitigate spam/scam listings
      allow create: if isEmailVerified() && request.resource.data.userId == request.auth.uid;
      
      // Owner can update their post, but cannot self-approve; Admin can update anything; Users can report
      allow update: if isAuthenticated() && (
        (isOwner(resource.data.userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])) || 
        isAdmin() || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isReported']))
      );
      
      // Only owner or admin can delete
      allow delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }
 
    // --- Services Collection ---
    match /services/{serviceId} {
      allow read: if true;
      allow create: if isEmailVerified() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (isOwner(resource.data.userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])) || 
        isAdmin() || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isReported']))
      );
      allow delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }
 
    // --- Favorites Collection (Row-Level Security) ---
    match /favorites/{favoriteId} {
      allow read, write: if isAuthenticated() && (
        (resource == null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
    }
 
    // --- Discussions Collection (Community Posts) ---
    match /discussions/{discussionId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (isOwner(resource.data.userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'createdAt'])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'reactions', 'commentCount', 'isReported'])) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }
 
    // --- Comments Collection ---
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (isOwner(resource.data.userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'createdAt'])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'isReported'])) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }
 
    // --- Stories Collection (24h Ephemeral Content) ---
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }
 
    // --- Notifications Collection (Strict Anti-Spoofing RLS) ---
    match /notifications/{notificationId} {
      // Authenticated users can create notifications for valid interactions (e.g. system bot, inquiries)
      allow create: if isAuthenticated();
      // Only the recipient can read, modify, or delete their notifications
      allow read, update, delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }
 
    // --- Conversations Subsystem (Private Messaging RLS) ---
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && ((request.auth.uid in resource.data.participants) || isAdmin());
      allow create: if isAuthenticated() && ((request.auth.uid in request.resource.data.participants) || isAdmin());
      allow update: if isAuthenticated() && ((request.auth.uid in resource.data.participants) || isAdmin());
      allow delete: if isAuthenticated() && ((request.auth.uid in resource.data.participants) || isAdmin());
 
      // Messages sub-collection
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants) || 
          isAdmin()
        );
        allow create: if isAuthenticated() && 
          ((request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants) || isAdmin()) && 
          (request.resource.data.senderId == request.auth.uid);
        allow update: if isAuthenticated() && 
          ((request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants) || isAdmin()) && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) ||
            (resource.data.senderId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'isEdited']))
          );
        allow delete: if isAuthenticated() && (
          (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants) || 
          isAdmin()
        );
      }
    }
 
    // --- Leads Collection (Strict RLS) ---
    match /leads/{leadId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }
 
    // --- Enrollments Collection (Strict RLS) ---
    match /enrollments/{enrollmentId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }

    // --- Newsletter Subscribers ---
    match /newsletter_subscribers/{subId} {
      allow create, update: if isAuthenticated() && request.auth.uid == subId;
      allow read, delete: if isAdmin();
    }
  }
}
